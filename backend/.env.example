# Copy to .env and fill in. Never commit .env.
APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# PostgreSQL URL from your provider; leave unset in dev to use a local SQLite file.
DATABASE_URL=
# Comma-separated exact origins of the React app (no wildcard).
FRONTEND_ORIGINS=http://localhost:5173,http://172.16.12.208:5173
# Production only. "Lax" if frontend and API share a registrable domain, "None" if fully cross-site.
SESSION_COOKIE_SAMESITE=Lax
# Set to 1 behind a reverse proxy (Render) so client IPs / HTTPS are read correctly.
TRUST_PROXY=0
PORT=5000
